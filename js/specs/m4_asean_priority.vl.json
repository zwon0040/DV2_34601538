{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "M4. ASEAN choropleth with a year slider + linked line chart: government health spending as a share of all government spending, 2000-2023.",
  "data": {
    "url": "data/asean_health_spending_2000_2023.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "gov_health_pct_gov_spending": "number",
        "che_pct_gdp": "number",
        "oop_pct_che": "number",
        "che_per_capita_usd": "number"
      }
    }
  },
  "params": [
    {
      "name": "year_pick",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 2000,
        "max": 2023,
        "step": 1,
        "name": "Year shown on the map: "
      }
    }
  ],
  "vconcat": [
    {
      "width": 560,
      "height": 380,
      "projection": {
        "type": "azimuthalEqualArea",
        "rotate": [
          -115,
          -8,
          0
        ]
      },
      "layer": [
        {
          "data": {
            "url": "geo/asean_countries.topojson",
            "format": {
              "type": "topojson",
              "feature": "countries"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#CAD6E2",
            "stroke": "#EDE1E5",
            "strokeWidth": 0.8
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year === year_pick && isValid(datum.gov_health_pct_gov_spending)"
            },
            {
              "lookup": "iso3",
              "from": {
                "data": {
                  "url": "geo/asean_countries.topojson",
                  "format": {
                    "type": "topojson",
                    "feature": "countries"
                  }
                },
                "key": "properties.iso3"
              },
              "as": "geo"
            },
            {
              "calculate": "datum.gov_health_pct_gov_spending < 4 ? 'Under 4%' : datum.gov_health_pct_gov_spending < 7 ? '4 to 7%' : datum.gov_health_pct_gov_spending < 10 ? '7 to 10%' : datum.gov_health_pct_gov_spending < 13 ? '10 to 13%' : '13% or more'",
              "as": "band"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "#EDE1E5",
            "strokeWidth": 0.8
          },
          "encoding": {
            "shape": {
              "field": "geo",
              "type": "geojson"
            },
            "color": {
              "field": "band",
              "type": "ordinal",
              "title": "Health share of government spending",
              "scale": {
                "domain": [
                  "Under 4%",
                  "4 to 7%",
                  "7 to 10%",
                  "10 to 13%",
                  "13% or more"
                ],
                "range": [
                  "#C3E6D7",
                  "#A6DCC8",
                  "#5DBE9C",
                  "#1E9573",
                  "#00614A"
                ]
              },
              "legend": {
                "orient": "top-right",
                "symbolType": "square",
                "symbolSize": 180,
                "labelFontSize": 12,
                "titleLimit": 260
              }
            },
            "strokeWidth": {
              "condition": {
                "test": "datum.iso3 === 'MYS'",
                "value": 2.5
              },
              "value": 0.8
            },
            "stroke": {
              "condition": {
                "test": "datum.iso3 === 'MYS'",
                "value": "#1F2933"
              },
              "value": "#EDE1E5"
            },
            "tooltip": [
              {
                "field": "country",
                "type": "nominal",
                "title": "Country"
              },
              {
                "field": "year",
                "type": "quantitative",
                "title": "Year",
                "format": "d"
              },
              {
                "field": "gov_health_pct_gov_spending",
                "type": "quantitative",
                "title": "Health share of government spending (%)",
                "format": ".1f"
              },
              {
                "field": "oop_pct_che",
                "type": "quantitative",
                "title": "Paid out of pocket (%)",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {}
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 22,
            "fontWeight": 700,
            "color": "#1F2933",
            "font": "'Plus Jakarta Sans', sans-serif",
            "text": {
              "expr": "year_pick"
            }
          },
          "encoding": {
            "x": {
              "value": 6
            },
            "y": {
              "value": 350
            }
          }
        }
      ]
    },
    {
      "width": 560,
      "height": 200,
      "layer": [
        {
          "mark": {
            "type": "line",
            "strokeWidth": 1.5,
            "interpolate": "linear"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative",
              "title": null,
              "axis": {
                "format": "d",
                "tickCount": 6,
                "grid": false
              }
            },
            "y": {
              "field": "gov_health_pct_gov_spending",
              "type": "quantitative",
              "title": "% of government spending"
            },
            "detail": {
              "field": "country"
            },
            "color": {
              "condition": [
                {
                  "test": "datum.iso3 === 'MYS'",
                  "value": "#007A5E"
                },
                {
                  "test": "datum.iso3 === 'THA' || datum.iso3 === 'SGP'",
                  "value": "#7B8794"
                }
              ],
              "value": "#B8C4D0"
            },
            "strokeWidth": {
              "condition": {
                "test": "datum.iso3 === 'MYS'",
                "value": 3
              },
              "value": 1.5
            },
            "order": {
              "condition": {
                "test": "datum.iso3 === 'MYS'",
                "value": 1
              },
              "value": 0
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 30,
            "opacity": 0
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "field": "gov_health_pct_gov_spending",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "country",
                "type": "nominal",
                "title": "Country"
              },
              {
                "field": "year",
                "type": "quantitative",
                "title": "Year",
                "format": "d"
              },
              {
                "field": "gov_health_pct_gov_spending",
                "type": "quantitative",
                "title": "Health share of government spending (%)",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year === 2023 && (datum.iso3 === 'MYS' || datum.iso3 === 'SGP' || datum.iso3 === 'THA')"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 6,
            "fontSize": 11
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "field": "gov_health_pct_gov_spending",
              "type": "quantitative"
            },
            "text": {
              "field": "country"
            },
            "color": {
              "condition": {
                "test": "datum.iso3 === 'MYS'",
                "value": "#1F2933"
              },
              "value": "#52606D"
            }
          }
        },
        {
          "data": {
            "values": [
              {}
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#1F2933",
            "strokeDash": [
              4,
              3
            ]
          },
          "encoding": {
            "x": {
              "datum": {
                "expr": "year_pick"
              },
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.iso3 === 'MYS' && datum.year === 2021"
            },
            {
              "calculate": "'Malaysia peak: ' + format(datum.gov_health_pct_gov_spending, '.1f') + '% (2021)'",
              "as": "t"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -8,
            "dy": -10,
            "fontSize": 11,
            "fontWeight": 700,
            "color": "#1F2933"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "field": "gov_health_pct_gov_spending",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    }
  ],
  "spacing": 24
}