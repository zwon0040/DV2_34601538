{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C2. Waffle chart: who paid Malaysia's 2024 health bill. One square = about RM1 billion.",
  "width": 340,
  "height": 306,
  "data": {
    "url": "data/mnha_financing_sources_2011_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "rm_mil": "number",
        "pct_teh": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year === 2024"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "rm_mil",
          "as": "rm_mil"
        }
      ],
      "groupby": [
        "payer_group"
      ]
    },
    {
      "calculate": "round(datum.rm_mil / 1000)",
      "as": "squares"
    },
    {
      "calculate": "indexof(['Ministry of Health', 'Other government', 'Households (out of pocket)', 'Private insurance', 'Employers and others'], datum.payer_group)",
      "as": "order"
    },
    {
      "calculate": "sequence(0, datum.squares)",
      "as": "square_id"
    },
    {
      "flatten": [
        "square_id"
      ]
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "n"
        }
      ],
      "sort": [
        {
          "field": "order"
        },
        {
          "field": "square_id"
        }
      ]
    },
    {
      "calculate": "(datum.n - 1) % 10",
      "as": "col"
    },
    {
      "calculate": "floor((datum.n - 1) / 10)",
      "as": "row"
    },
    {
      "calculate": "'RM' + format(datum.rm_mil / 1000, '.1f') + ' billion'",
      "as": "amount"
    }
  ],
  "mark": {
    "type": "rect",
    "cornerRadius": 3
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "paddingInner": 0.15
      }
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "paddingInner": 0.15
      }
    },
    "color": {
      "field": "payer_group",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Ministry of Health",
          "Other government",
          "Households (out of pocket)",
          "Private insurance",
          "Employers and others"
        ],
        "range": [
          "#007A5E",
          "#3DB58F",
          "#E69F00",
          "#C065A6",
          "#7D3C6E"
        ]
      },
      "legend": {
        "orient": "right",
        "symbolType": "square",
        "symbolSize": 160,
        "labelFontSize": 13,
        "rowPadding": 8,
        "labelLimit": 300,
        "labelExpr": "datum.value === 'Ministry of Health' ? 'Ministry of Health \u00b7 RM39.1 billion' : datum.value === 'Other government' ? 'Other government \u00b7 RM6.4 billion' : datum.value === 'Households (out of pocket)' ? 'Families (out of pocket) \u00b7 RM34.8 billion' : datum.value === 'Private insurance' ? 'Private insurance \u00b7 RM7.1 billion' : 'Employers and others \u00b7 RM2.3 billion'"
      }
    },
    "tooltip": [
      {
        "field": "payer_group",
        "type": "nominal",
        "title": "Paid by"
      },
      {
        "field": "amount",
        "type": "nominal",
        "title": "Amount in 2024"
      }
    ],
    "opacity": {
      "condition": {
        "param": "legend_pick",
        "value": 1
      },
      "value": 0.2
    }
  },
  "params": [
    {
      "name": "legend_pick",
      "select": {
        "type": "point",
        "fields": [
          "payer_group"
        ]
      },
      "bind": "legend"
    }
  ]
}