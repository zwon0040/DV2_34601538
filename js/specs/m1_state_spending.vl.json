{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dorling cartogram of health spending by state, 2024. Each state is a circle placed near its location; circle area shows population and colour shows total health spending per person. Circles are moved apart so none overlap.",
  "width": 540,
  "height": 280,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "geo/malaysia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#DCE3EA",
        "stroke": "#EDE1E5",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/mnha_state_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "population": "number",
            "expenditure_rm_mil": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.expenditure_rm_mil * 1e6 / datum.population",
          "as": "per_person"
        },
        {
          "calculate": "datum.per_person < 2000 ? 'Under RM2,000' : datum.per_person < 2500 ? 'RM2,000 to 2,499' : datum.per_person < 3000 ? 'RM2,500 to 2,999' : datum.per_person < 5000 ? 'RM3,000 to 4,999' : 'RM5,000 or more'",
          "as": "band"
        },
        {
          "calculate": "replace(datum.state, 'W.P. ', '')",
          "as": "name"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "geo/malaysia_dorling_positions.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "longitude": "number",
                  "latitude": "number",
                  "label_longitude": "number",
                  "label_latitude": "number",
                  "leader": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "longitude",
              "latitude",
              "label_longitude",
              "label_latitude",
              "label_align",
              "leader"
            ]
          }
        },
        {
          "calculate": "indexof(['Sabah','Kuala Lumpur','Putrajaya'], datum.name) >= 0 ? datum.name + ' RM' + format(datum.per_person, ',.0f') : datum.name",
          "as": "label"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.leader === 1"
            }
          ],
          "mark": {
            "type": "rule",
            "color": "#52606D",
            "strokeWidth": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "label_longitude"
            },
            "latitude2": {
              "field": "label_latitude"
            }
          }
        },
        {
          "mark": {
            "type": "circle",
            "opacity": 1,
            "stroke": "#FFFFFF",
            "strokeWidth": 1.2
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "population",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  7363400
                ],
                "range": [
                  0,
                  2000
                ]
              },
              "legend": {
                "orient": "none",
                "legendX": 20,
                "legendY": 238,
                "values": [
                  1000000,
                  3000000,
                  7000000
                ],
                "labelExpr": "format(datum.value/1e6,'.0f') + ' million'",
                "symbolFillColor": "#C9D2DC",
                "symbolStrokeColor": "#FFFFFF",
                "symbolOpacity": 1,
                "direction": "horizontal",
                "rowPadding": 3
              },
              "title": "Population"
            },
            "color": {
              "field": "band",
              "type": "ordinal",
              "title": "Spending per person, 2024",
              "scale": {
                "domain": [
                  "Under RM2,000",
                  "RM2,000 to 2,499",
                  "RM2,500 to 2,999",
                  "RM3,000 to 4,999",
                  "RM5,000 or more"
                ],
                "range": [
                  "#BFCCF2",
                  "#A8BAEC",
                  "#7390DF",
                  "#3A5FCD",
                  "#1F3A93"
                ]
              },
              "legend": {
                "orient": "none",
                "legendX": 200,
                "legendY": 0,
                "symbolType": "circle",
                "symbolSize": 160,
                "title": "Spending per person, 2024"
              }
            },
            "order": {
              "field": "population",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "name",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "per_person",
                "type": "quantitative",
                "title": "RM per person",
                "format": ",.0f"
              },
              {
                "field": "expenditure_rm_mil",
                "type": "quantitative",
                "title": "Total (RM million)",
                "format": ",.0f"
              },
              {
                "field": "population",
                "type": "quantitative",
                "title": "Population",
                "format": ","
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_align === 'right'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "fontSize": 11,
            "color": "#3E4C59"
          },
          "encoding": {
            "longitude": {
              "field": "label_longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_align === 'left'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 11,
            "color": "#3E4C59"
          },
          "encoding": {
            "longitude": {
              "field": "label_longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_align === 'center'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "middle",
            "fontSize": 11,
            "color": "#1F2933"
          },
          "encoding": {
            "longitude": {
              "field": "label_longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    }
  ]
}