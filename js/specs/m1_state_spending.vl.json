{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dorling cartogram of health spending by state, 2024. Each state is a circle; circle area shows population and colour shows health spending per person. Circles start near each state's location and are packed together so neighbours touch but none overlap. No base map is drawn, so circle positions are approximate.",
  "width": 580,
  "height": 300,
  "projection": {
    "type": "mercator",
    "scale": 1800,
    "center": [
      106.0,
      4.2
    ],
    "translate": [
      290,
      150
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/mnha_state_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "population": "number",
            "expenditure_rm_mil": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.expenditure_rm_mil * 1e6 / datum.population",
          "as": "per_person"
        },
        {
          "calculate": "datum.per_person < 2000 ? 'Under RM2,000' : datum.per_person < 2500 ? 'RM2,000 to 2,499' : datum.per_person < 3000 ? 'RM2,500 to 2,999' : datum.per_person < 5000 ? 'RM3,000 to 4,999' : 'RM5,000 or more'",
          "as": "band"
        },
        {
          "calculate": "replace(datum.state, 'W.P. ', '')",
          "as": "name"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "geo/malaysia_dorling_positions.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "longitude": "number",
                  "latitude": "number",
                  "label_longitude": "number",
                  "label_latitude": "number",
                  "leader": "number",
                  "leader_longitude": "number",
                  "leader_latitude": "number",
                  "leader_end_longitude": "number",
                  "leader_end_latitude": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "longitude",
              "latitude",
              "label_longitude",
              "label_latitude",
              "label_align",
              "leader",
              "leader_longitude",
              "leader_latitude",
              "leader_end_longitude",
              "leader_end_latitude"
            ]
          }
        },
        {
          "calculate": "datum.label_align === 'inside' ? split(datum.name, ' ') : datum.name",
          "as": "label_lines"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "opacity": 1,
            "stroke": "#FFFFFF",
            "strokeWidth": 1.2
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "population",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  7363400
                ],
                "range": [
                  0,
                  5200
                ]
              },
              "legend": {
                "orient": "none",
                "legendX": 470,
                "legendY": 125,
                "values": [
                  1000000,
                  3000000,
                  7000000
                ],
                "labelExpr": "format(datum.value/1e6,'.0f') + ' million'",
                "symbolFillColor": "#C9D2DC",
                "symbolStrokeColor": "#FFFFFF",
                "symbolOpacity": 1,
                "direction": "vertical",
                "rowPadding": 3
              },
              "title": "Population"
            },
            "color": {
              "field": "band",
              "type": "ordinal",
              "title": "Spending per person, 2024",
              "scale": {
                "domain": [
                  "Under RM2,000",
                  "RM2,000 to 2,499",
                  "RM2,500 to 2,999",
                  "RM3,000 to 4,999",
                  "RM5,000 or more"
                ],
                "range": [
                  "#BFCCF2",
                  "#A8BAEC",
                  "#7390DF",
                  "#3A5FCD",
                  "#1F3A93"
                ]
              },
              "legend": {
                "orient": "none",
                "legendX": 470,
                "legendY": 0,
                "symbolType": "circle",
                "symbolSize": 160,
                "title": "Spending per person, 2024"
              }
            },
            "order": {
              "field": "population",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "name",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "per_person",
                "type": "quantitative",
                "title": "RM per person",
                "format": ",.0f"
              },
              {
                "field": "expenditure_rm_mil",
                "type": "quantitative",
                "title": "Total (RM million)",
                "format": ",.0f"
              },
              {
                "field": "population",
                "type": "quantitative",
                "title": "Population",
                "format": ","
              }
            ],
            "opacity": {
              "condition": {
                "param": "legend_pick",
                "value": 1
              },
              "value": 0.2
            }
          },
          "params": [
            {
              "name": "legend_pick",
              "select": {
                "type": "point",
                "fields": [
                  "band"
                ]
              },
              "bind": "legend"
            }
          ]
        },
        {
          "transform": [
            {
              "filter": "toNumber(datum.leader) === 1"
            }
          ],
          "mark": {
            "type": "rule",
            "color": "#52606D",
            "strokeWidth": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "leader_longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "leader_latitude",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "leader_end_longitude"
            },
            "latitude2": {
              "field": "leader_end_latitude"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_align === 'right'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "fontSize": 11,
            "color": "#3E4C59"
          },
          "encoding": {
            "longitude": {
              "field": "label_longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "label_lines"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_align === 'left'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 11,
            "color": "#3E4C59"
          },
          "encoding": {
            "longitude": {
              "field": "label_longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "label_lines"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_align === 'center'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "middle",
            "fontSize": 11,
            "lineHeight": 10.5
          },
          "encoding": {
            "longitude": {
              "field": "label_longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "label_lines"
            },
            "color": {
              "value": "#3E4C59"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_align === 'inside'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "middle",
            "fontSize": 9.5,
            "lineHeight": 10.5
          },
          "encoding": {
            "longitude": {
              "field": "label_longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "label_lines"
            },
            "color": {
              "condition": {
                "test": "datum.per_person >= 3000",
                "value": "#FFFFFF"
              },
              "value": "#1F2933"
            }
          }
        }
      ]
    }
  ]
}