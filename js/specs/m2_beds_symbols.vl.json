{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Graduated symbol map of public-sector hospital beds by state in 2022. Circles come in four size classes of bed counts; colour shows beds per 10,000 people.",
  "width": 560,
  "height": 300,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "geo/malaysia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#CAD6E2",
        "stroke": "#FBE9EA",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/hospital_beds_state.csv",
        "format": {
          "type": "csv",
          "parse": {
            "beds": "number",
            "date": "date"
          }
        }
      },
      "transform": [
        {
          "filter": "utcyear(datum.date) === 2022 && datum.state !== 'Malaysia'"
        },
        {
          "pivot": "type",
          "value": "beds",
          "groupby": [
            "state"
          ]
        },
        {
          "calculate": "datum.all - datum.hospital_non_moh",
          "as": "moh_beds"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "geo/malaysia_state_label_points.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "longitude": "number",
                  "latitude": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "longitude",
              "latitude"
            ]
          }
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/population_state_2022.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "population_thousands": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "population_thousands"
            ]
          }
        },
        {
          "calculate": "datum.all / datum.population_thousands * 10",
          "as": "per_10k"
        },
        {
          "calculate": "replace(datum.state, 'W.P. ', '')",
          "as": "name"
        },
        {
          "calculate": "datum.per_10k < 12 ? 'Under 12' : datum.per_10k < 15 ? '12 to 15' : datum.per_10k < 20 ? '15 to 20' : '20 or more'",
          "as": "rate_class"
        },
        {
          "calculate": "datum.all < 1000 ? 'Under 1,000' : datum.all < 3000 ? '1,000 to 2,999' : datum.all < 5000 ? '3,000 to 4,999' : '5,000 or more'",
          "as": "bed_class"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "opacity": 0.9,
            "stroke": "#FBE9EA",
            "strokeWidth": 1.5
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "bed_class",
              "type": "ordinal",
              "title": "Public hospital beds",
              "scale": {
                "domain": [
                  "Under 1,000",
                  "1,000 to 2,999",
                  "3,000 to 4,999",
                  "5,000 or more"
                ],
                "range": [
                  40,
                  200,
                  500,
                  1000
                ],
                "type": "ordinal"
              },
              "legend": {
                "orient": "none",
                "legendX": 0,
                "legendY": 268,
                "direction": "horizontal",
                "symbolFillColor": "#9AA5B1",
                "symbolOpacity": 0.85,
                "symbolStrokeColor": "#FBE9EA",
                "titleFontSize": 11,
                "labelFontSize": 11,
                "rowPadding": 2,
                "columns": 4
              }
            },
            "order": {
              "field": "all",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "name",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "all",
                "type": "quantitative",
                "title": "Public hospital beds",
                "format": ","
              },
              {
                "field": "moh_beds",
                "type": "quantitative",
                "title": "of which Ministry of Health",
                "format": ","
              },
              {
                "field": "per_10k",
                "type": "quantitative",
                "title": "Beds per 10,000 people",
                "format": ".1f"
              }
            ],
            "color": {
              "field": "rate_class",
              "type": "ordinal",
              "title": "Beds per 10,000 people",
              "scale": {
                "domain": [
                  "Under 12",
                  "12 to 15",
                  "15 to 20",
                  "20 or more"
                ],
                "range": [
                  "#A6DCC8",
                  "#5DBE9C",
                  "#1E9573",
                  "#00614A"
                ]
              },
              "legend": {
                "orient": "none",
                "legendX": 300,
                "legendY": 0,
                "direction": "vertical",
                "symbolType": "circle",
                "symbolSize": 90,
                "titleFontSize": 11,
                "labelFontSize": 11,
                "rowPadding": 1
              }
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.name === 'Selangor'"
            },
            {
              "calculate": "datum.name + ': ' + format(datum.all, ',') + ' beds, ' + format(datum.per_10k, '.1f') + ' per 10,000 people'",
              "as": "label"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 26,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#1F2933"
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.name === 'Labuan'"
            },
            {
              "calculate": "datum.name + ': ' + format(datum.all, ',') + ' beds, ' + format(datum.per_10k, '.1f') + ' per 10,000 people'",
              "as": "label"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -12,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#1F2933",
            "dy": 18
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    }
  ]
}