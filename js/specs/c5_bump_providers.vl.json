{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C5. Bump chart: rank of where health money is spent (providers), 2011-2024. Each place has its own colour; pharmacies (rust, the same colour as medicines in the streamgraph) and labs, imaging and ambulance (dark ink) are drawn stronger because the story mentions them.",
  "width": 360,
  "height": 260,
  "data": {
    "url": "data/mnha_providers_2011_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "total_rm_mil": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.short_label !== 'Nursing homes' && datum.short_label !== 'Overseas providers'"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "groupby": [
        "year"
      ],
      "sort": [
        {
          "field": "total_rm_mil",
          "order": "descending"
        }
      ]
    },
    {
      "calculate": "datum.short_label === 'Labs, imaging, ambulance' || datum.short_label === 'Pharmacies and medical shops'",
      "as": "highlight"
    },
    {
      "calculate": "'RM' + format(datum.total_rm_mil / 1000, '.1f') + ' billion'",
      "as": "amt"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          2011,
          2024
        ]
      },
      "axis": {
        "orient": "top",
        "values": [
          2011,
          2016,
          2021,
          2024
        ],
        "format": "d",
        "domain": false,
        "ticks": false,
        "grid": false,
        "labelFontSize": 12,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          0.6,
          7.4
        ],
        "reverse": true
      },
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "domain": false,
        "ticks": false,
        "grid": false,
        "labelFontSize": 12,
        "labelPadding": 10
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "short_label"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "monotone"
      },
      "encoding": {
        "detail": {
          "field": "short_label"
        },
        "color": {
          "field": "short_label",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Hospitals",
              "Clinics",
              "Administration and insurers",
              "Pharmacies and medical shops",
              "Other industries",
              "Public health programmes",
              "Labs, imaging, ambulance"
            ],
            "range": [
              "#6E87A6",
              "#A0968C",
              "#B39B73",
              "#C0563A",
              "#9C8AA5",
              "#7FA3A8",
              "#1F2933"
            ]
          }
        },
        "strokeWidth": {
          "condition": [
            {
              "param": "hover",
              "empty": false,
              "value": 4
            },
            {
              "test": "datum.highlight",
              "value": 3.2
            }
          ],
          "value": 2.2
        },
        "opacity": {
          "condition": [
            {
              "param": "hover",
              "empty": true,
              "value": 1
            }
          ],
          "value": 0.3
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 40,
        "opacity": 0
      },
      "encoding": {
        "tooltip": [
          {
            "field": "short_label",
            "type": "nominal",
            "title": "Where money was spent"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank"
          },
          {
            "field": "amt",
            "type": "nominal",
            "title": "Spent"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 40
      },
      "encoding": {
        "color": {
          "field": "short_label",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Hospitals",
              "Clinics",
              "Administration and insurers",
              "Pharmacies and medical shops",
              "Other industries",
              "Public health programmes",
              "Labs, imaging, ambulance"
            ],
            "range": [
              "#6E87A6",
              "#A0968C",
              "#B39B73",
              "#C0563A",
              "#9C8AA5",
              "#7FA3A8",
              "#1F2933"
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.3
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2024"
        },
        {
          "calculate": "datum.short_label + '  ' + datum.amt",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "lab"
        },
        "color": {
          "field": "short_label",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Hospitals",
              "Clinics",
              "Administration and insurers",
              "Pharmacies and medical shops",
              "Other industries",
              "Public health programmes",
              "Labs, imaging, ambulance"
            ],
            "range": [
              "#4F6A8C",
              "#6E655C",
              "#7D6640",
              "#A3472E",
              "#6E5A7A",
              "#4F7378",
              "#1F2933"
            ]
          }
        },
        "fontWeight": {
          "condition": {
            "test": "datum.highlight",
            "value": 700
          },
          "value": 400
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2021,
            "t1": "2021: COVID-19",
            "t2": "Labs, imaging and ambulance jump",
            "t3": "from RM0.5 billion to RM4.5 billion, then fall back"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#1F2933",
            "strokeDash": [
              2,
              2
            ]
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "value": 170
            },
            "y2": {
              "value": 266
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -8,
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#1F2933"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "value": 278
            },
            "text": {
              "field": "t1"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -8,
            "fontSize": 12,
            "color": "#1F2933"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "value": 293
            },
            "text": {
              "field": "t2"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -8,
            "fontSize": 12,
            "color": "#1F2933"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "value": 308
            },
            "text": {
              "field": "t3"
            }
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}